<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Swipe down on home opens the notification shade. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- "Uninstall" in the app options sheet. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Time checks (Usage Breaker): reminders are notifications; usage access is granted by the user in Settings. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Package visibility (Android 11+): every launchable app, icon packs, web search. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
        <intent><action android:name="org.adw.launcher.icons.ACTION_PICK_ICON" /></intent>
        <intent><action android:name="android.intent.action.WEB_SEARCH" /></intent>
        <intent><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent>
    </queries>

    <application
        android:name=".DriftlistApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Driftlist"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="Driftlist settings"
            android:taskAffinity="dev.farjad.driftlist.settings"
            android:theme="@style/Theme.Driftlist.Settings" />

        <!-- Quick Lock: double-tap the alphabet to turn the screen off. Reads no events or content. -->
        <service
            android:name=".system.QuickLockService"
            android:exported="false"
            android:label="Driftlist Quick Lock"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/quick_lock_service" />
        </service>

        <receiver
            android:name=".system.notifications.SummaryReceiver"
            android:exported="false" />

        <service
            android:name=".system.notifications.DriftNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
